AETHER_OWNER_USERNAME=owner
AETHER_OWNER_PASSWORD=
AETHER_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
AETHER_DATA_DIR=/data
AETHER_PUBLIC_URL=https://ai-production-df18.up.railway.app
AETHER_APK_SERVER_URL=https://ai-production-df18.up.railway.app
AETHER_AUTO_LOCAL_AI=1
AETHER_LOCAL_AI_MODEL=Qwen3-0.6B-Q4_K_M.gguf
AETHER_AI_CONTEXT=2048
AETHER_AI_THREADS=2
AETHER_AI_MAX_TOKENS=384
AETHER_AI_TEMPERATURE=0.2
AETHER_JOB_WORKERS=2
AETHER_MAX_UPLOAD_BYTES=52428800
AETHER_ENABLE_STABLE_DIFFUSION=1
AETHER_STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
AETHER_SD_MAX_RETRIES=0
AETHER_SD_RETRY_DELAY=30
