AETHER_HOST=127.0.0.1
AETHER_PORT=8080
AETHER_SECRET_KEY=replace-with-a-long-random-secret
AETHER_WORKSPACE=./workspace
AETHER_LOCAL_AI_URL=http://127.0.0.1:8090/v1/chat/completions
AETHER_LOCAL_AI_KEY=local
AETHER_LOCAL_AI_MODEL=Qwen3-0.6B-Q4_K_M.gguf
AETHER_DATA_DIR=/data
AETHER_AUTO_LOCAL_AI=1
AETHER_ENABLE_STABLE_DIFFUSION=1
AETHER_STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
